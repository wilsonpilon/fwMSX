### fwMSX (projeto)
# Diretorio de build intermediario do CMake/Ninja (nao e o pacote final).
# /build/ e' usado pelo build.ps1 (Windows); /build-linux/ pelo build.sh
# (Linux/WSL) -- diretorios SEPARADOS de proposito, senao alternar entre
# compilar pelo Windows nativo e pelo WSL no mesmo checkout quebra o
# CMakeCache.txt (ele grava caminho absoluto, e /mnt/c/... vs C:/... para
# o mesmo diretorio conta como "cache de outro lugar" pro CMake).
/build/
/build-linux/

# dist/ e um entregavel do projeto: os executaveis e os pacotes de
# distribuicao (ZIP do build.ps1/Windows, tar.gz do build.sh/Linux) devem
# permanecer versionados, mesmo com as regras genericas *.exe/*.zip
# acima. Regras de unignore precisam vir por ultimo no arquivo (a ultima
# regra que casa e a que vale).
!/dist/
!/dist/*.exe
!/dist/*.zip
!/dist/*.tar.gz

# Os binarios ELF "crus" do Linux (sem extensao -- fwMSX/msxdisk, gerados
# por build.sh) NAO sao versionados, ao contrario do .exe do Windows: nao
# rodam fora de Linux e o tar.gz ja' os empacota, entao mante-los tambem
# soltos aqui so' duplicaria o binario sem beneficio (regra depois do
# "unignore" acima, que e' a que vale por ultimo).
/dist/fwMSX
/dist/msxdisk

# z80test.exe/z80dbgtest.exe/memmaptest.exe/vdptest.exe sao os
# executaveis de teste do nucleo Z80/mapa de memoria/VDP (ver
# doc/z80-core-spec.md, doc/memory-map-spec.md, doc/vdp-spec.md) -- uteis
# localmente, mas nao sao entregaveis do projeto como msxdisk.exe/
# fwMSX.exe, entao ficam de fora do versionamento (regra depois do
# "unignore" acima, que e' a que vale por ultimo).
/dist/z80test.exe
/dist/z80dbgtest.exe
/dist/memmaptest.exe
/dist/vdptest.exe
/dist/ppitest.exe
/dist/psgtest.exe
/dist/machinetest.exe
/dist/audiotest.exe
/dist/scctest.exe
/dist/fmtest.exe
/dist/romdbtest.exe
/dist/fmtest
/dist/videofiltertest.exe
/dist/videofiltertest
/dist/scctest
/dist/fdctest.exe
/dist/vdp2test.exe
/dist/msx2test.exe
/dist/z80test
/dist/z80dbgtest
/dist/memmaptest
/dist/vdptest
/dist/ppitest
/dist/psgtest
/dist/machinetest
/dist/audiotest
/dist/fdctest
/dist/vdp2test
/dist/msx2test
/dist/romdbtest
/dist/tapetest.exe
/dist/tapetest
/dist/castooltest.exe
/dist/castooltest
/dist/tapedbtest.exe
/dist/tapedbtest

# Diretorios de build gerados automaticamente pelo CLion
/cmake-build-*/

# Configuracoes de IDE (JetBrains/CLion)
/.idea/

# Layout de janela salvo automaticamente pela GUI do msxdisk (Dear ImGui)
# no diretorio onde o executavel foi rodado -- preferencia por maquina,
# nao faz sentido versionar.
imgui.ini

# Arquivos de SRAM (.sav) gravados ao lado das ROMs (ex.: resource/fMSX/FMPAC.sav)
*.sav
/dist/splashtest.exe
/dist/splashtest
/dist/fwmsx.cfg

