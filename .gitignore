### fwMSX (projeto)
# Diretorio de build intermediario do CMake/Ninja (nao e o pacote final)
/build/

# dist/ e um entregavel do projeto: o executavel e o ZIP de distribuicao
# sao gerados por build.ps1 e devem permanecer versionados, mesmo com as
# regras genericas *.exe/*.zip acima. Regras de unignore precisam vir
# por ultimo no arquivo (a ultima regra que casa e a que vale).
!/dist/
!/dist/*.exe
!/dist/*.zip

# z80test.exe/z80dbgtest.exe/memmaptest.exe sao os executaveis de teste
# do nucleo Z80/mapa de memoria (ver doc/z80-core-spec.md,
# doc/memory-map-spec.md) -- uteis localmente, mas nao sao entregaveis do
# projeto como msxdisk.exe/fwMSX.exe, entao ficam de fora do
# versionamento (regra depois do "unignore" acima, que e' a que vale por
# ultimo).
/dist/z80test.exe
/dist/z80dbgtest.exe
/dist/memmaptest.exe

# Diretorios de build gerados automaticamente pelo CLion
/cmake-build-*/

# Configuracoes de IDE (JetBrains/CLion)
/.idea/

# Layout de janela salvo automaticamente pela GUI do msxdisk (Dear ImGui)
# no diretorio onde o executavel foi rodado -- preferencia por maquina,
# nao faz sentido versionar.
imgui.ini
