10 A=1:B=12:C=300:D=40000:E=1234567:F=1.5:G=1E5:H=1.5E-3:I=2D+10
20 X$="hello ""quoted"" world":Y$=CHR$(65)+MID$(X$,1,2)+LEFT$(X$,3)
30 IF A=1 THEN 100 ELSE 200
40 ON A GOTO 100,200,,300
50 GOSUB 1000:RETURN:RESTORE 20:RUN 10
60 FOR I=1 TO 10 STEP 2:NEXT I
70 DATA 1,2,"a,b",c d,:REM comment : not tokenized
80 'apostrophe comment
90 CALL FOO(1,2):_BAR(3):CALL BAZ
100 OPEN "A:FILE" FOR INPUT AS #1
110 INPUT #1,A$,B$:CLOSE 1
120 SCREEN 2,2:COLOR 15,4,4:LINE(0,0)-(10,10),1,BF:PAINT(5,5),2
130 PRINT USING "##.##";A;SPC(3);TAB(4)
140 DEFUSR1=&HC000:X=USR1(0):Y=USR(2)
150 A=&H1F+&O17+&B101+&HFFFF
160 PRINT A;B,C
170 IF A<>B AND C>=D OR NOT E THEN PRINT "x"
180 A=VAL("12")+ASC("A")+INSTR(A$,"B")+LEN(A$)
190 SPRITE$(1)=CHR$(255):VPOKE &H1800,0:BASE(5)=&H1800
200 A!=3.14159265358979:B#=3.14159265358979:C%=123
210 X=1.0:Y=0.5!:Z=7#:W=.000123:V=100000000
220 A=B^2+SQR(3)*SIN(.5)/COS(.5)-ATN(1)
230 PLAY "T120L8CDEFGAB":SOUND 7,&B10111000
240 KEY 1,"test":KEY(1) ON:ON KEY GOSUB 1000
250 IF A THEN B ELSE C
260 X=-1:Y=+2:Z=1-1
270 TIME=0:INTERVAL ON:ON INTERVAL=50 GOSUB 300
280 A$=STRING$(5,"*")+SPACE$(3)+HEX$(255)+BIN$(5)+OCT$(8)+STR$(1)
290 PRINT #1,"x":LPRINT "y":WIDTH 40
300 ERROR 5:RESUME 20:RESUME NEXT:ON ERROR GOTO 900
310 DEF FNA(X)=X*2:Y=FNA(3)
320 DIM A(10,10),B$(5):ERASE A
330 POKE &HF3DF,1:OUT 152,0:WAIT 152,1:A=INP(152)
340 BSAVE "X",&HC000,&HC100:BLOAD "X",R
350 MAXFILES=2:CLEAR 200,&HDFFF:DEFINT A-Z
360 A=1 : B=2 : C=3
370 REM
380 '
390 DATA
400 PRINT "end"
